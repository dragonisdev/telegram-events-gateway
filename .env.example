# Create API credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Recommended locally: a Telethon session file. For Railway, use string:<value>
# in a sealed variable so no persistent volume is needed. Treat either form like
# a password. See docs/feature/session-security.md and docs/deployment/railway.md.
TELEGRAM_SESSION=file:telegram-event-gateway

# Comma-separated Telegram chat/channel IDs. Private channels usually start -100.
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

WEBHOOK_URL=http://127.0.0.1:8787/events

# Optional delivery/runtime tuning.
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_SECONDS=1
TELEGRAM_RECONNECT_BACKOFF_SECONDS=5
LOG_LEVEL=INFO
